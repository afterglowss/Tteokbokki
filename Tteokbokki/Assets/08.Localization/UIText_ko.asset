  - m_Id: 315165939982336
    m_Localized: "<size=140%><font=\"KimjungchulMyungjo-Bold SDF\">\uAD70\uC790 \uB5A1\uBCF6\uC774
      \uC8FC\uBC29 \uB9E4\uB274\uC5BC</font></size>\r\n<size=80%><color=#888888>\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</color></size>\r\n\r\n<size=120%><font=\"KimjungchulMyungjo-Bold
      SDF\">1. \uC8FC\uBC29 \uC870\uC791\uC758 \uAE30\uCD08 (Controls)</font></size>\r\n\uBCA0\uD14C\uB791
      \uC0AC\uC7A5\uB2D8\uC740 \uC190\uBCF4\uB2E4 \uD0A4\uBCF4\uB4DC\uAC00 \uB354
      \uBE60\uB985\uB2C8\uB2E4! \uB9C8\uC6B0\uC2A4 \uD074\uB9AD\uB3C4 \uAC00\uB2A5\uD558\uC9C0\uB9CC,
      \uC544\uB798 \uB2E8\uCD95\uD0A4\uB97C \uC775\uD600\uBCF4\uC138\uC694.\r\n\r\n\u25B6
      <font=\"KimjungchulMyungjo-Bold SDF\">\uD654\uAD6C \uC120\uD0DD</font>: \uC22B\uC790
      \uD0A4 <color=#87CEEB>1 ~ 5\uBC88</color>\uC744 \uB20C\uB7EC \uC870\uB9AC\uD560
      \uD654\uAD6C\uB97C \uC989\uC2DC \uC120\uD0DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\u25B6
      <font=\"KimjungchulMyungjo-Bold SDF\">\uC7AC\uB8CC \uD22C\uC785</font>: \uD654\uAD6C\uB97C
      \uC120\uD0DD\uD55C \uC0C1\uD0DC\uC5D0\uC11C \uD0A4\uBCF4\uB4DC\uB97C \uB20C\uB7EC
      \uC7AC\uB8CC\uB97C \uB123\uC73C\uC138\uC694.\r\n    - <color=#FFA500>\uC0C1\uB2E8
      \uC120\uBC18 (Q, W, E, R, T, Y, U)</color>: \uB5A1, \uC624\uB385, \uD30C \uB4F1
      \uAE30\uBCF8 \uC7AC\uB8CC.\r\n    - <color=#FFA500>\uC911\uB2E8 \uC120\uBC18
      (A, S, D, F, G, H, J)</color>: \uACE0\uAD6C\uB9C8, \uACC4\uB780, \uB77C\uBA74
      \uB4F1 \uAC01\uC885 \uD1A0\uD551.\r\n    - <color=#FFA500>\uD558\uB2E8 \uC120\uBC18
      (Z, X, C, V, B, N, M)</color>: \uBA54\uB274\uC758 \uB9DB\uC744 \uACB0\uC815\uD558\uB294
      \uB2E4\uC591\uD55C \uC18C\uC2A4.\n    <size=80%><Tip> \uC0C1\uB300\uC801\uC73C\uB85C
      \uBA40\uB9AC \uC788\uB294 \uD0A4\uB294 <color=#87CEEB>Shift</color>\uB97C \uB20C\uB7EC
      \uAC00\uAE4C\uC6B4 \uD0A4\uB85C \uBC14\uAFC0 \uC218 \uC788\uC2B5\uB2C8\uB2E4.</size>\r\n\u25B6
      <font=\"KimjungchulMyungjo-Bold SDF\">\uC870\uB9AC \uC2DC\uC791</font>: \uC7AC\uB8CC\uB97C
      \uB2E4 \uB123\uC5C8\uB2E4\uBA74 <color=#87CEEB>Space \uBC14</color>\uB97C \uB20C\uB7EC
      \uBD88\uC744 \uC62C\uB9AC\uC138\uC694.\r\n\r\n<size=80%><color=#888888>\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</color></size>\r\n\r\n<size=120%><font=\"KimjungchulMyungjo-Bold
      SDF\">2. \uC644\uBCBD\uD55C \uC870\uB9AC \uBE44\uBC95 (Cooking)</font></size>\r\n\u25B6
      <font=\"KimjungchulMyungjo-Bold SDF\">\uAE30\uBCF8 \uC911\uC758 \uAE30\uBCF8</font>:
      \uBAA8\uB4E0 \uB5A1\uBCF6\uC774\uC5D0\uB294 <color=#FF6347>\uB5A1 2\uAC1C,
      \uC624\uB385 2\uAC1C, \uD30C 1\uAC1C, \uC591\uBC30\uCD94 1\uAC1C</color>\uC640
      <color=#FF6347>\uC18C\uC2A4 1\uC885</color>\uC774 \uBC18\uB4DC\uC2DC \uB4E4\uC5B4\uAC00\uC57C
      \uD569\uB2C8\uB2E4.\r\n\u25B6 <font=\"KimjungchulMyungjo-Bold SDF\">\uBA54\uB274
      \uACB0\uC815</font>: \uD544\uC218 \uC7AC\uB8CC \uC678\uC5D0 \uD22C\uC785\uD558\uB294
      \uC18C\uC2A4\uC758 \uC885\uB958\uC5D0 \uB530\uB77C \uCD5C\uC885 \uBA54\uB274\uAC00
      \uACB0\uC815\uB429\uB2C8\uB2E4. \uC18C\uC2A4\uAC00 \uBE60\uC9C0\uBA74 \uC870\uB9AC\uB97C
      \uC2DC\uC791\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\r\n\u25B6 <font=\"KimjungchulMyungjo-Bold
      SDF\">\uC870\uB9AC \uC644\uB8CC</font>: \uBD88\uC744 \uC62C\uB9AC\uACE0 \uAC8C\uC774\uC9C0\uAC00
      \uB05D\uAE4C\uC9C0 \uCC28\uBA74 \uC870\uB9AC\uAC00 \uC644\uB8CC\uB429\uB2C8\uB2E4.
      \uC774\uB54C \uC74C\uC2DD\uC744 \uB4DC\uB798\uADF8\uD558\uC5EC \uD3EC\uC7A5\uB300\uB85C
      \uC62E\uAE38 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n<size=80%><color=#888888>\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</color></size>\r\n\r\n<size=120%><font=\"KimjungchulMyungjo-Bold
      SDF\">3. \uD3EC\uC7A5 \uBC0F \uBC30\uB2EC (Delivery)</font></size>\r\n\u25B6
      <font=\"KimjungchulMyungjo-Bold SDF\">\uD3EC\uC7A5\uD558\uAE30</font>: \uC870\uB9AC
      \uC644\uB8CC\uB41C \uC6CD\uC744 \uD3EC\uC7A5\uB300 \uC2AC\uB86F\uC73C\uB85C
      \uB4DC\uB798\uADF8\uD558\uBA74 \uBC30\uB2EC \uC6A9\uAE30\uC5D0 \uC608\uC058\uAC8C
      \uB2F4\uAE41\uB2C8\uB2E4.\r\n\u25B6 <font=\"KimjungchulMyungjo-Bold SDF\">\uC801\uC7AC
      \uC2DC\uC2A4\uD15C</font>: \uD3EC\uC7A5\uB300 \uD55C \uCE78\uC5D0\uB294 \uCD5C\uB300
      <color=#87CEEB>3\uAC1C</color>\uAE4C\uC9C0 \uC74C\uC2DD\uC744 \uC313\uC544\uB458
      \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\u25B6 <font=\"KimjungchulMyungjo-Bold
      SDF\">\uBC30\uB2EC \uC644\uB8CC</font>: \uD654\uBA74 \uC6B0\uCE21\uC758 \uC601\uC218\uC99D\uC744
      \uB4DC\uB798\uADF8\uD558\uC5EC \uD3EC\uC7A5\uB41C \uC74C\uC2DD \uC704\uC5D0
      \uC62C\uB9AC\uBA74 \uBC30\uB2EC\uC774 \uC2DC\uC791\uB429\uB2C8\uB2E4.\r\n\u25B6
      <font=\"KimjungchulMyungjo-Bold SDF\">\uC138\uBC00\uD55C \uD310\uC815</font>:
      \uC190\uB2D8\uC774 \uC694\uCCAD\uD55C \uBA54\uB274\uC640 <font=\"KimjungchulMyungjo-Bold
      SDF\">\uCD94\uAC00 \uC7AC\uB8CC(\uD1A0\uD551)</font>\uAC00 \uC601\uC218\uC99D\uACFC
      \uC644\uBCBD\uD788 \uC77C\uCE58\uD574\uC57C\uB9CC \uC131\uACF5\uC785\uB2C8\uB2E4.\r\n\u25B6
      <font=\"KimjungchulMyungjo-Bold SDF\">\uBC30\uB2EC \uC2E4\uD328</font>: \uC798\uBABB\uB41C
      \uC74C\uC2DD\uC744 \uBC30\uB2EC\uD558\uBA74 \uC218\uC775\uC744 \uC5BB\uC9C0
      \uBABB\uD560 \uBFD0\uB9CC \uC544\uB2C8\uB77C \uADF8 \uAE38\uB85C \uD56D\uC758
      \uC804\uD654\uB97C \uBC1B\uC744\uC9C0\uB3C4 \uBAA8\uB985\uB2C8\uB2E4!\r\n\r\n<size=80%><color=#888888>\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</color></size>\r\n\r\n<size=120%><font=\"KimjungchulMyungjo-Bold
      SDF\">4. \uC0AC\uC7A5\uB2D8\uC774 \uAF2D \uC54C\uC544\uC57C \uD560 \uC6B4\uC601
      \uC0C1\uC2DD</font></size>\r\n\u25B6 <font=\"KimjungchulMyungjo-Bold SDF\">\uAE34\uAE09
      \uC870\uAE30 \uB9C8\uAC10</font>: \uC8FC\uBC29\uC758 \uD544\uC218 \uC7AC\uB8CC\uAC00
      \uD558\uB098\uB77C\uB3C4 \uB5A8\uC5B4\uC9C0\uAC70\uB098, \uC18C\uC2A4\uAC00
      \uC644\uC804\uD788 \uBC14\uB2E5\uB098\uBA74 \uAC15\uC81C\uB85C \uC601\uC5C5\uC774
      \uC885\uB8CC\uB429\uB2C8\uB2E4. \uD56D\uC0C1 \uC7AC\uACE0\uB97C \uD655\uC778\uD558\uC138\uC694!\r\n\u25B6
      <font=\"KimjungchulMyungjo-Bold SDF\">\uD56D\uC758 \uC804\uD654</font>: \uC8FC\uBB38
      \uC2DC\uAC04\uC744 \uB108\uBB34 \uC624\uB798 \uB04C\uAC70\uB098 \uC74C\uC2DD\uC744
      \uC798\uBABB \uBC30\uB2EC\uD558\uBA74 \uC804\uD654\uBCA8\uC774 \uC6B8\uB9BD\uB2C8\uB2E4.
      \uC804\uD654\uB97C \uBE68\uB9AC \uBC1B\uC9C0 \uC54A\uC73C\uBA74 \uC190\uB2D8\uC758
      \uC794\uC18C\uB9AC\uB97C \uB354 \uAE38\uAC8C \uB4E4\uC5B4\uC57C \uD558\uB2C8
      \uC8FC\uC758\uD558\uC138\uC694.\r\n\u25B6 <font=\"KimjungchulMyungjo-Bold SDF\">\uD734\uC9C0\uD1B5</font>:
      \uC7AC\uB8CC\uB97C \uB123\uB294 \uC911 \uC2E4\uC218\uD588\uAC70\uB098 \uC798\uBABB
      \uB9CC\uB4E0 \uC74C\uC2DD\uC740 \uD734\uC9C0\uD1B5\uC5D0 \uBC84\uB9B4 \uC218
      \uC788\uC2B5\uB2C8\uB2E4. \uC601\uC218\uC99D\uB3C4 \uB9C8\uCC2C\uAC00\uC9C0\uC774\uB2C8
      \uAC10\uB2F9\uD560 \uC218 \uC5C6\uB294 \uC8FC\uBB38\uC774\uB77C\uBA74 \uBBF8\uB9AC
      \uCDE8\uC18C\uD574\uBC84\uB9AC\uC138\uC694!\r\n\u25B6 <font=\"KimjungchulMyungjo-Bold
      SDF\">\uB9C8\uAC10\uACFC \uC138\uAE08</font>: \uC601\uC5C5\uC774 \uC885\uB8CC\uB418\uBA74
      \uC624\uB298 \uBC88 \uB3C8\uC5D0\uC11C \uC138\uAE08\uC744 \uB0B4\uC57C \uD569\uB2C8\uB2E4.
      \uCC28\uC775\uC744 \uACC4\uC0B0\uD560 \uB54C \uC138\uAE08\uC744 \uBE7C\uBA39\uC9C0
      \uC54A\uB3C4\uB85D \uC8FC\uC758\uD558\uC138\uC694!\r\n\u25B6 <font=\"KimjungchulMyungjo-Bold
      SDF\">\uB0B4\uC77C\uC758 \uBCF4\uB108\uC2A4</font>: \uB9E4\uC77C \uB9C8\uAC10
      \uC2DC \uBCF4\uB108\uC2A4 \uC7AC\uB8CC 2\uC885\uC774 \uBC1C\uD45C\uB429\uB2C8\uB2E4.
      \uC774 \uC7AC\uB8CC\uAC00 \uB4E4\uC5B4\uAC04 \uC74C\uC2DD\uC744 \uD314\uBA74
      \uD558\uB098\uB2F9 <color=#FF6347>5,000\uC6D0</color>\uC758 \uBCF4\uB108\uC2A4\uB97C
      \uCD94\uAC00\uB85C \uBC1B\uC2B5\uB2C8\uB2E4.\r\n\r\n<size=80%><color=#888888>\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500</color></size>\r\n\r\n<size=125%><font=\"KimjungchulMyungjo-Bold
      SDF\"><color=#32CD32>\uBCA0\uD14C\uB791 \uC0AC\uC7A5\uB2D8\uC758 \uAFC0\uD301
      (Secret Tips)</color></font></size>\r\n1. <font=\"KimjungchulMyungjo-Bold SDF\">\uC601\uC218\uC99D\uC744
      \uD074\uB9AD\uD558\uC138\uC694!</font>: \uC6B0\uCE21 \uC601\uC218\uC99D\uC744
      \uD074\uB9AD\uD558\uBA74 \uD544\uC694\uD55C \uC804\uCCB4 \uC7AC\uB8CC \uAC1C\uC218\uAC00
      \uD55C\uB208\uC5D0 \uC815\uB9AC\uB429\uB2C8\uB2E4. \uB9AC\uC2A4\uD2B8\uB97C
      \uBCF4\uACE0 \uB2E8\uCD95\uD0A4\uB85C \uC7AC\uB8CC\uB97C \uBE60\uB974\uAC8C
      \uD22C\uC785\uD558\uC138\uC694.\r\n2. <font=\"KimjungchulMyungjo-Bold SDF\">\uB3CB\uBCF4\uAE30\uB97C
      \uD65C\uC6A9\uD558\uC138\uC694</font>: \uC870\uB9AC\uB41C \uC74C\uC2DD \uC704\uC5D0
      \uB9C8\uC6B0\uC2A4\uB97C \uC62C\uB9AC\uBA74 \uC5B4\uB5A4 \uC7AC\uB8CC\uAC00
      \uB4E4\uC5B4\uAC14\uB294\uC9C0 \uD655\uC778\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uC601\uC218\uC99D\uACFC \uB300\uC870\uD574\uBCF4\uACE0 \uC2E4\uC218 \uC5C6\uC774
      \uBC30\uB2EC\uD558\uC138\uC694.\r\n3. <font=\"KimjungchulMyungjo-Bold SDF\">\uC0C1\uC810\uC758
      \uD3B8\uB9AC\uD568</font>: \uB9C8\uAC10 \uD6C4 \uC0C1\uC810\uC5D0\uC11C\uB294
      <color=#87CEEB>'\uBD80\uC871\uBD84 1\uAC1C\uC529 \uB2F4\uAE30'</color> \uBC84\uD2BC\uC73C\uB85C
      \uAC04\uD3B8\uD558\uAC8C \uC7AC\uACE0\uB97C \uCC44\uC6B8 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uB2E8, \uBAA8\uB4E0 \uC7AC\uB8CC\uB294 \uD55C \uBC88\uC5D0 \uCD5C\uB300 <color=#FF6347>3\uC138\uD2B8</color>\uAE4C\uC9C0\uB9CC
      \uC8FC\uBB38 \uAC00\uB2A5\uD569\uB2C8\uB2E4.\r\n4. <font=\"KimjungchulMyungjo-Bold
      SDF\">\uB300\uAE30\uC5F4\uC758 \uBE44\uBC00</font>: \uC601\uC218\uC99D \uC904\uC774
      \uAC00\uB4DD \uCC28\uB3C4 \uB2F9\uD669\uD558\uC9C0 \uB9C8\uC138\uC694. \uBCF4\uC774\uC9C0
      \uC54A\uB294 \uACF3\uC5D0 \uB300\uAE30 \uC911\uC778 \uC8FC\uBB38\uB4E4\uC774
      \uC904\uC744 \uC11C \uC788\uC2B5\uB2C8\uB2E4. \uD558\uB098\uB97C \uCC98\uB9AC\uD558\uBA74
      \uB2E4\uC74C \uC8FC\uBB38\uC774 \uC989\uC2DC \uB098\uD0C0\uB0A0\uAC81\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
