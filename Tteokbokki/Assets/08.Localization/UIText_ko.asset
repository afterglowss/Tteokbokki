      m_Items: []
  - m_Id: 38038183206922
    m_Localized: "<size=80%>(\uCD1D {0}\uAC1C \uD488\uBAA9)</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 38038183206923
    m_Localized: "\uB118\uC5B4\uAC00\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 38038183206924
