    m_Metadata:
      m_Items: []
  - m_Id: 38038183206925
    m_Localized: "\uC794\uACE0 \uBD80\uC871"
    m_Metadata:
      m_Items: []
  - m_Id: 40165827796992
    m_Localized: "\uD654\uAD6C\uB97C \uBA3C\uC800 \uC120\uD0DD\uD574\uC8FC\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 40165920071680
    m_Localized: "{0}\\n\uB0A8\uC740 \uC8FC\uBB38\uC744 \uCC98\uB9AC\uD558\uAC70\uB098
      \uC2DC\uAC04\uC774 \uC9C0\uB098\uBA74\\n\uC601\uC5C5\uC744 \uC885\uB8CC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 40165920071681
    m_Localized: "<color=red>[\uAE34\uAE09 \uC601\uC5C5 \uC885\uB8CC]</color> {0}
      \uC794\uC5EC \uC8FC\uBB38 \uCC98\uB9AC \uC2DC \uC989\uC2DC \uB9C8\uAC10\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 42467355648000
    m_Localized: "\uD544\uC218 \uC7AC\uB8CC '{0}' \uC18C\uC9C4!"
    m_Metadata:
      m_Items: []
  - m_Id: 42467355648001
    m_Localized: "\uBAA8\uB4E0 \uC18C\uC2A4 \uC18C\uC9C4!"
    m_Metadata:
      m_Items: []
  - m_Id: 42467355648002
    m_Localized: "\uC7AC\uACE0\uB85C \uC870\uB9AC \uAC00\uB2A5\uD55C \uBA54\uB274\uAC00
      \uC5C6\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 42467355648003
    m_Localized: "\uC8FC\uBB38\uBC88\uD638 {0} \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 42467355648004
    m_Localized: "\uC8FC\uBB38\uBC88\uD638 {0}\uC758 \uBA54\uB274\uBCC4 \uC7AC\uB8CC
      \uBAA9\uB85D\\n\\n"
    m_Metadata:
      m_Items: []
  - m_Id: 42467355648005
    m_Localized: "[{0}] {1} \uC804\uCCB4 \uC7AC\uB8CC \uBAA9\uB85D\\n"
    m_Metadata:
      m_Items: []
  - m_Id: 42467355648006
    m_Localized: "\uC62C\uBC14\uB978 \uC8FC\uBB38\uBC88\uD638\uB97C \uC785\uB825\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 42467355648007
    m_Localized: "\uB0A0\uC9DC \uD615\uC2DD\uC774 \uC798\uBABB\uB418\uC5C8\uC2B5\uB2C8\uB2E4
      (yyyy-MM-dd, yyyymmdd, yyyy-MM-dd_\uBC88\uD638, yyyymmdd_\uBC88\uD638)"
    m_Metadata:
      m_Items: []
  - m_Id: 42467355648008
    m_Localized: "{0} \uC8FC\uBB38\uBC88\uD638 {1}\uC5D0 \uD574\uB2F9\uD558\uB294
      \uC601\uC218\uC99D\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 42467355648009
    m_Localized: "\uAE30\uBCF8 \uC7AC\uB8CC\uAC00 \uBD80\uC871\uD558\uAC70\uB098
      \uC18C\uC2A4\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 42986354630656
    m_Localized: "{0}\uC740(\uB294) \uD55C \uD654\uAD6C\uC5D0 \uCD5C\uB300 10\uAC1C\uAE4C\uC9C0\uB9CC
      \uB123\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 43260129435648
    m_Localized: "{0} \uC7AC\uACE0\uAC00 \uBD80\uC871\uD569\uB2C8\uB2E4!"
    m_Metadata:
      m_Items: []
  - m_Id: 44068531200000
    m_Localized: "\uD654\uAD6C\uB97C \uBA3C\uC800 \uC120\uD0DD\uD574\uC8FC\uC138\uC694
      (1~5)"
    m_Metadata:
      m_Items: []
  - m_Id: 44068531200001
    m_Localized: "\uC870\uB9AC \uC911\uC774\uAC70\uB098 \uC74C\uC2DD\uC774 \uC788\uB294
