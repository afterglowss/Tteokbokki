  - m_Id: 38038183206912
    m_Localized: "\uBCF4\uB108\uC2A4 \uC815\uBCF4 \uC5C6\uC74C"
    m_Metadata:
      m_Items: []
  - m_Id: 38038183206913
    m_Localized: "\uC804\uCCB4 1\uAC1C\uC529"
    m_Metadata:
      m_Items: []
  - m_Id: 38038183206914
    m_Localized: "\uBD80\uC871\uBD84 1\uAC1C\uC529"
    m_Metadata:
      m_Items: []
  - m_Id: 38038183206915
    m_Localized: "\uBE44\uC6B0\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 38038183206916
    m_Localized: "\uC7A5\uBC14\uAD6C\uB2C8\uAC00 \uC774\uBBF8 \uBE44\uC5B4\uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 38038183206917
    m_Localized: "\uBAA8\uB4E0 \uC7AC\uB8CC\uAC00 \uAD6C\uB9E4 \uC81C\uD55C(3\uAC1C)\uC5D0
      \uB3C4\uB2EC\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 38038183206918
    m_Localized: "\uBD80\uC871\uD55C \uC7AC\uB8CC\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 38038183206919
    m_Localized: "\uBD80\uC871\uD55C \uC7AC\uB8CC\uB4E4\uC774 \uC774\uBBF8 \uAD6C\uB9E4
      \uC81C\uD55C(3\uAC1C)\uC5D0 \uB3C4\uB2EC\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 38038183206920
    m_Localized: "<color=#888888>\uC7A5\uBC14\uAD6C\uB2C8\uAC00 \uBE44\uC5B4\uC788\uC2B5\uB2C8\uB2E4.</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 38038183206921
    m_Localized: "\uCD1D \uC8FC\uBB38 \uAE08\uC561: <color=#D95400>{0:N0}\uC6D0</color>"
